<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href = "/css/global.css">
        <title>Off Beat - maimaiDX chart reviewer</title>
    </head>

    <body>
        <div class="parent">
            {{> header currentUser=currentUser home="true" }}
            <search>
                <div class="search_bar">
                    <input type="text" placeholder="Search song..." id="search_text">
                </div>
                <button class="search_button" id="search_button"><img src="/assets/icons/search.png"></button>
                <div class="select_holder">
                    <select class="diff_sel" id="diff_sel"> 
                        <option value="" disabled selected> Filter by difficulty</option>
                        <option value="Expert"> Expert </option>
                        <option value="Master"> Master </option>
                        <option value="Re:Master"> Re:Master </option>
                        <option value=""> All Difficulties </option>
                    </select> 
                </div>

                <div class="select_holder">
                    <select class="sort_by" id="sort_by"> 
                        <option value="" disabled selected> Sort by </option>
                        {{#unless (isCharter currentUser.userType)}}
                        <option value="charter"> Charter </option>
                        {{/unless}}
                        <option value="songtitle"> Song Title </option>
                        <option value="rating"> Rating </option>
                    </select> 
                </div>
            </search>
            <div class="card_holder" id="charts_div">
            {{> chart_list charts=charts }}
            </div>
        </div>

        <script>
            const searchText = document.getElementById("search_text");
            const searchButton = document.getElementById("search_button");
            const diffSelDropdown = document.getElementById("diff_sel");
            const sortByDropdown = document.getElementById("sort_by");
            const chartsDiv = document.getElementById("charts_div");

            // renders charts based on search, filter, and sort by
            async function renderCharts() {
                const query = {
                    search: searchText.value,
                    difficulty: diffSelDropdown.value,
                    sort: sortByDropdown.value
                };

                const params = new URLSearchParams(query);

                const response = await fetch(`/search_charts?${params}`);

                const chartsHtml = await response.text();

                chartsDiv.innerHTML = chartsHtml;
            }

            searchText.addEventListener("keydown", (event) => {
                if (event.key === "Enter" && !event.repeat) {
                    renderCharts();
                }
            });

            searchButton.addEventListener("click", renderCharts);
            diffSelDropdown.addEventListener("change", renderCharts);
            sortByDropdown.addEventListener("change", renderCharts);
        </script>
    </body>

</html>