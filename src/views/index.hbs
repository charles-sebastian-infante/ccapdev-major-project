<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href = "/css/global.css">
        <title>Off Beat - maimaiDX chart reviewer </title>
    </head>

    <body>
        <div class="parent">
            <header>
                <div class="header_left">
                    <img class="icon" src="/assets/icons/music_icon.png">
                    <div class="header_text">
                    <h1>Off Beat: Rhythm Rating Dashboard</h1>
                    <p>Rate and track your favorite rhythm game songs</p>
                    </div>
                </div>
                <a href = "/signup">
                    <img class="icon" src="/assets/icons/pfp_placeholder.png"> 
                </a>
            </header>

            <search>
                <div class="search_bar">
                    <input type="text" placeholder="Search song">
                </div>
            
                <div class="select_holder">
                    <select class="diff_sel"> 
                        <option value="" disabled selected> Filter by difficulty</option>
                        <option value="exp"> Expert </option>
                        <option value="mas"> Master </option>
                        <option value="remas"> Re:Master </option>
                    </select> 
                </div>

                <div class="select_holder">
                    <select class="sort_by"> 
                        <option value="" disabled selected> Sort by </option>
                        <option value="exp"> Genre </option>
                        <option value="mas"> Charter </option>
                        <option value="remas"> Internal Level </option>
                    </select> 
                </div>
            </search>
            <div class="card_holder">
                {{#each charts}}
                <a href="/charts/{{_id}}">
                <div class="chart_card {{dlToLongName difficultyLevel}}">
                    <div class="jacket_holder">
                        <img src="{{imagePath}}">
                    </div>
                    <div class="chart_info">
                        <p class="title">{{songName}}</p>
                        <p>{{songAuthor}}</p>
                        <p>Charter: {{charterId.username}}</p>
                        <div> 
                            <span class="level_diff {{dlToShortName difficultyLevel}}">{{round numericRating 1}}</span>
                            <span class="level_diff {{dlToShortName difficultyLevel}}">{{difficultyLevel}}</span>
                        </div>
                    </div>
                </div>
                </a>
                {{/each}}
            </div>
        </div>
    
    </body>

</html>