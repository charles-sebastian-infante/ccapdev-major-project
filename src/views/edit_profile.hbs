<!DOCTYPE html>
<html>
    <head>
        <title>Off Beat - Edit Profile</title>
        <link rel="stylesheet" href="/css/global.css">
        <link rel="stylesheet" href="/css/profile.css">
    </head>

    <body data-user-id="{{currentUser._id}}">
        {{> header currentUser=currentUser }}
        <main class = "parent">
            <section class="profile_display">
                <img src="{{currentUser.imagePath}}" alt="profile_picture" class="avatar">
            <div class = "user_info">
                <h1> My Profile </h1>
                <dl>
                    <dt>Username: </dt>
                    <dd id="user_username">{{currentUser.username}}</dd>
                </dl>
                <dl>
                    <dt>Email: </dt>
                    <dd id="user_email">{{currentUser.email}}</dd>
                </dl>
                <dl>
                    <dt>Rating: </dt>
                    <dd id="user_rating">{{currentUser.rating}}</dd>
                </dl>
                <dl>
                    <dt>Description: </dt>
                    <dd id="user_description">{{currentUser.description}}</dd>
                </dl>
            </div>      
            </section>

            <div class = "form_edit">
            <section class="edit_profile">
                <h2> Edit Profile </h2>
                <form id="edit_profile_form">
                    <label for="new_avatar"> Avatar </label>
                    <input name="image" type="file" id="new_avatar" accept="image/jpeg, image/png, image/webp"> 
                    
                    <label for="new_username">Username</label>
                    <input name="username" type="text" id="new_username" value="{{currentUser.username}}" required>

                    <label for="new_email"> Email </label>
                    <input name="email" type="email" id="new_email" value="{{currentUser.email}}" required>

                    <label for="new_rating"> Rating </label>
                    <input name="rating" type="number" id="new_rating" value="{{currentUser.rating}}" min="0" max="20000" required>

                    <label for="new_description"> Description </label>
                    <textarea name="description" placeholder="Your new description goes here" id="new_description">
                        {{~#if currentUser.description}}{{currentUser.description}}{{else}}(none){{/if}}</textarea>

                    <button type="submit"> Save Changes </button>
                </form>
            </section>
            </div>

            <div class="security_form">
            <section class="security_settings">
                <h2> Security Settings </h2>
                <form id="change_password_form">
                    <label for="current_pw"> Current password: </label>
                    <input name="current_pw" type="password" id="current_pw" required>
                    <label for="new_pw"> New password: </label>
                    <input name="new_pw" type="password" id="new_pw" required>
                    <label for="confirm_pw"> Confirm password: </label>
                    <input name="confirm_pw" type="password" id="confirm_pw" required>
                    <button type="submit"> Save Password </button>
                </form>
            </section>
            </div>

            <button class="logout" id="logout"> Log Out </button>
        </main>

        <script>
            const logoutBtn = document.getElementById("logout");
            const editProfileForm = document.getElementById("edit_profile_form");
            const changePasswordForm = document.getElementById("change_password_form");
            
            const userId = document.body.dataset.userId;

            logoutBtn.addEventListener("click", async (event) => {
                const response = await fetch("/logout", { method: "POST" });

                if (!response.ok) {
                    alert("There was an error logging out.");
                    return;
                }

                window.location.href = response.url;
            });

            editProfileForm.addEventListener("submit", async (event) => {
                event.preventDefault();

                const userData = new FormData(editProfileForm);
                
                const response = await fetch("/edit_profile", {
                    method: "POST",
                    body: userData
                });

                if (!response.ok) {
                    const message = await response.text();
                    if (message) {
                        alert(message);
                    }
                    return;
                }

                const responseObj = await response.json();
                const { success } = responseObj;

                if (success) {
                    alert("Profile successfully edited.");
                }

                location.reload(); // refresh page to show changes
            });

            changePasswordForm.addEventListener("submit", async (event) => {
                event.preventDefault();

                const passwordData = new FormData(changePasswordForm);
                const currentPw = passwordData.get("current_pw");
                const newPw = passwordData.get("new_pw");
                const confirmPw = passwordData.get("confirm_pw");

                if (newPw !== confirmPw) {
                    alert("Error: New password and confirm password do not match.");
                    return;
                }
                if (currentPw === newPw) {
                    alert("Error: Current password and new password are the same.");
                    return;
                }

                const response = await fetch("/change_password", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ currentPw, newPw })
                })

                if (!response.ok) {
                    const message = await response.text();
                    if (message) {
                        alert(message);
                    }
                    return;
                }

                const responseObj = await response.json();
                const { success } = responseObj;

                if (success) {
                    alert("Password successfully changed.");
                }
            });
        </script>
    </body>
</html>