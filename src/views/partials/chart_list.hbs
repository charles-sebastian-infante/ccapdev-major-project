{{#each charts}}
<a href="/charts/{{_id}}">
    <div class="chart_card {{dlToLongName difficultyLevel}}">
        <div class="jacket_holder">
            <img src="{{imagePath}}">
        </div>
        <div class="chart_info">
            <p class="title">{{songName}}</p>
            <p>{{songAuthor}}</p>
            <p>Charter: {{charterId.username}}</p>
            <div>
                <span class="level_diff {{dlToShortName difficultyLevel}}">{{round numericRating 1}}</span>
                <span class="level_diff {{dlToShortName difficultyLevel}}">{{difficultyLevel}}</span>
            </div>
            <p class="users_think"> Users think this is a: {{displayRating averageRating 1}} </p>
            <div class="ratings">
                <p>{{displayPercent accuratePercent}}</p> <img src="/assets/icons/reco.png">
                <p>{{displayPercent notAccuratePercent}}</p> <img src="/assets/icons/not_reco.png">
            </div>
        </div>
    </div>
</a>
{{else}}
<p>No charts yet...</p>
{{/each}}