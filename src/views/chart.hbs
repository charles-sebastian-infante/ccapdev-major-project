<!DOCTYPE html>
<html>

<head>
    <title> off beat: rate charts </title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/review_page.css">
</head>
<body>
     <div class="parent">
            {{> header currentUser=currentUser }}
            <div class="chart_card">
                <div class="jacket_holder">
                    <img src="{{chart.imagePath}}">
                </div>
                <div class="chart_info">
                    <p class="title">{{chart.songName}}</p>
                    <p>{{chart.songAuthor}}</p>
                    <p>Charter: {{chart.charterId.username}}</p>
                    <div> 
                        <span class="level_diff {{dlToShortName chart.difficultyLevel}}">{{round chart.numericRating 1}}</span>
                        <span class="level_diff {{dlToShortName chart.difficultyLevel}}">{{chart.difficultyLevel}}</span>
                    </div>   
                </div>
            </div>
        </div>

        <div class="reviews_holder">
            <div class="prev_reviews">
                <h2> Previous Reviews </h2>

                <search class="search_bar">
                    <input type="text" placeholder="Search comments...">
                </search>
            
                <div class="review_wrapper" id="reviews_div">
                    {{#each chart.reviews}}
                    <div class="prev_review_instance">
                        <div class="user_info">
                            <img src="{{userId.imagePath}}" class="user_avatar">
                            <span class="user_skill">{{userId.rating}}</span>
                        </div>
                        <div class="review_content">
                            <div class="review_header">
                                <span class="username">{{userId.username}}</span>
                                <span class="user_cc">{{round rating 1}}</span>
                                <img src="/assets/icons/
                                {{~#if ratedAccurately}}reco.png{{else}}not_reco.png{{/if~}}                                
                                " class="recommendation_icon">
                            </div>
                            <p class="review_comment">{{body}}</p>
                        </div>
                        <div class="review_actions">
                            <button class="see_full">
                                <span> See full review </span>
                            </button>
                            <button class="like_button">
                                <img src="/assets/icons/heart.png" class="icon">
                                <span class="like_count">{{displayLikeCount likes}}</span>
                            </button>
                        </div>
                    </div>
                        {{#if charterResponse}}
                    <div class="charter_response">
                        <div class="charter_response_header">
                            <img src="{{../chart.charterId.imagePath}}" class="charter_avatar">
                            <span class="charter_name"><i>Charter Response: {{../chart.charterId.username}}</i></span>
                        </div>
                        <p class="charter_response_text">{{charterResponse}}</p>
                    </div>
                        {{/if}}
                    {{else}}
                    <div class="prev_review_instance">
                        <p class="review_comment"> No reviews yet...</p>
                    </div>
                    {{/each}}
                </div>
            </div>

            <div class="user_review {{#unless currentUser}}blur{{/unless}}">
                <h2>{{#if currentUser}}My Review{{else}}Sign up/log in to review this chart!{{/if}}</h2>

            <form class="review_form" id="review_form">
                <div class="level_input_section">
                    <div class="reco_actions">
                        <input type="radio" id="acc" name="accuracy" value="accurate"
                            {{#if userReview.ratedAccurately}}checked{{/if}}>
                        <label class ="accurate" for="acc"> Rated Accurately </label>

                        <input type ="radio" id="notacc" name="accuracy" value="not_accurate"
                            {{#if (isFalse userReview.ratedAccurately)}}checked{{/if}}>
                        <label for="notacc" class ="not_accurate"> Not Rated Accurately </label>
                    </div>
                    
                    <label for="level_rating" class="accuracy_blur" id="slider_label">Level should be...</label>
                    <div class="slider_container accuracy_blur" id="slider_div">
                        <span class="range_label"> 11.5 </span>
                        <input name="rating" type="range" min="11.5" max="15.0"
                            value="{{#if userReview.rating}}{{userReview.rating}}{{else}}{{chart.numericRating}}{{/if}}"
                            class="level_range" id="level_rating" step="0.1">
                        <span class="range_label">15.0</span>
                    </div>
                </div>
                <div class="review_body">
                    <textarea name="body" class="review_text" placeholder="Write your review here..." rows="6">
                        {{~#if userReview.body}}{{userReview.body}}{{/if~}}
                    </textarea>
                    <input name="file" type="file" accept="video/*, image/jpeg, image/png, image/webp">
                </div>
                <div class="my_review_actions">
                    <button type="submit" class="delete_btn">Delete</button>
                    <button type="submit" class="submit_btn">Submit / Edit</button>
                </div>
            </form>
            </div>
        </div>

    <script>
        const reviewForm = document.getElementById("review_form");
        const accButton = document.getElementById("acc");
        const notAccButton = document.getElementById("notacc");
        const sliderLabel = document.getElementById("slider_label");
        const sliderDiv = document.getElementById("slider_div");
        const slider = document.getElementById("level_rating");
        const reviewsDiv = document.getElementById("reviews_div");

        const currRoute = window.location.pathname;
        const chartId = currRoute.split("/")[2];
        let chartRating = slider.value; // placeholder for until async function executes
        
        async function renderReviews() {
            const body = {}; // user should be able to filter/search for comments in the future

            const response = await fetch(currRoute, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(body)
            });

            const reviewsHtml = await response.text();

            reviewsDiv.innerHTML = reviewsHtml;
        }

        function updateAccuracySliderBlur() {
            if (accButton.checked) {
                slider.value = chartRating;
                sliderLabel.classList.add("accuracy_blur");
                sliderDiv.classList.add("accuracy_blur");
            } else if (notAccButton.checked) {
                sliderLabel.classList.remove("accuracy_blur");
                sliderDiv.classList.remove("accuracy_blur");
            }
        }

        async function getChartRating() {
            const response = await fetch("/get_chart_info/" + chartId);
            const chartInfo = await response.json();

            chartRating = chartInfo.numericRating;
        }

        getChartRating();
        updateAccuracySliderBlur();

        accButton.addEventListener("change", updateAccuracySliderBlur);
        notAccButton.addEventListener("change", updateAccuracySliderBlur);

		reviewForm.addEventListener("submit", async (event) => {
			event.preventDefault();

            const clickedButton = event.submitter;
            const buttonClasses = clickedButton.classList;
            const reviewInfo = new FormData(reviewForm);

            let response;
            if (buttonClasses.contains("delete_btn")) {
                response = await fetch(currRoute + "/delete_review", {
                    method: "POST"
                });
            } else {
                if (!reviewInfo.has("accuracy")) {
                    alert("Please select 'Rated Accurately' or 'Not Rated Accurately'.");
                    return;
                }

                if (reviewInfo.get("body") === "") {
                    alert("Please enter a form body.");
                    return;
                }

                response = await fetch(currRoute + "/submit_review", {
                    method: "POST",
                    body: reviewInfo
                });
            }

            if (!response.ok) {
                const message = await response.text();
                if (message) {
                    alert(message);
                }
                return;
            }

            const responseObj = await response.json();
            const { action, success } = responseObj;

            if (success) {
                await renderReviews(); // re-render the reviews to display the change

                switch (action) {
                    case "delete":
                        alert("Review successfully deleted.");
                        break;
                    case "edit":
                        alert("Review successfully edited.");
                        break;
                    case "submit":
                        alert("Review successfully submitted.");
                        break;
                }
            }
		});
	</script>
</body>

</html>