<!DOCTYPE html>
<html>

<head>
    <title>Off Beat - {{chart.songName}}</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/review_page.css">
</head>
<body>
     <div class="parent">
            {{> header currentUser=currentUser }}
            <div class="chart_card">
                <div class="jacket_holder">
                    <img src="{{chart.imagePath}}">
                </div>
                <div class="chart_info">
                    <p class="title">{{chart.songName}}</p>
                    <p>{{chart.songAuthor}}</p>
                    <p>Charter: {{chart.charterId.username}}</p>
                    <div> 
                        <span class="level_diff {{dlToShortName chart.difficultyLevel}}">{{round chart.numericRating 1}}</span>
                        <span class="level_diff {{dlToShortName chart.difficultyLevel}}">{{chart.difficultyLevel}}</span>
                    </div>   
                </div>
            </div>
        </div>

        <div class="reviews_holder">
            <div class="prev_reviews">
                <h2>{{#if (isCharter currentUser.userType)}}Reviews of Your Chart{{else}}Previous Reviews{{/if}}</h2>

                <search>
                    <div class="search_bar">
                        <input type="text" placeholder="Search comments..." id="search_text">
                    </div>
                    <button class="search_button" id="search_button"><img src="/assets/icons/search.png"></button>
                    <div class="select_holder">
                        <select class="acc_sel" id="acc_sel"> 
                            <option value="" disabled selected> Filter reviews </option>
                            <option value="accurate"> Accurate </option>
                            <option value="not_accurate"> Not Accurate </option>
                            <option value=""> All Reviews </option>
                        </select> 
                    </div>
                    <div class="select_holder">
                        <select class="sort_by" id="sort_by"> 
                            <option value="" disabled selected> Sort by </option>
                            <option value="most_likes"> Most Likes </option>
                            <option value="newest"> Newest </option>
                        </select> 
                    </div>
                </search>
            
                <div class="review_wrapper" id="reviews_div">
                {{> review_list reviews=chart.reviews }}
                </div>

                <dialog id="full_review">
                    <div class="review_dialog">
                        <div class="dialog_header">
                            <div class="avatar_group">
                                <img class="user_avatar" id="dialog_avatar">
                                <span class="user_skill" id="dialog_skill"></span>
                            </div>
                            <span class="username" id="dialog_username"></span>
                            <span class="user_cc" id="dialog_cc"></span>
                            <img class="recommendation_icon" id="dialog_reco_icon">
                        </div>
                        <p id="dialog_comment"></p>
                        <div class="review_attachment"></div>
                        <p class="review_additional_info" id="dialog_created_at"></p>
                        <p class="review_additional_info" id="dialog_edited_at"></p>
                        <div class="dialog_actions">
                            <button class="like_button" id="dialog_like_button">
                                <img src="/assets/icons/heart.png" class="icon" id="dialog_like_icon">
                                <span class="like_count" id="dialog_likes"></span>
                            </button>
                            <button onclick="closeReview();" class="exit">Exit Review</button>    
                        </div>
                    </div>
                </dialog>
            </div>

            <div class="user_review {{#unless currentUser}}blur{{/unless}} {{#if (isCharter currentUser.userType)}}hidden{{/if}}"
            id="review_form_div">
                <h2>{{#if currentUser}}
                        {{#if (isCharter currentUser.userType)}}My Reply{{else}}My Review{{/if}}
                    {{else}}Sign up/log in to review this chart!{{/if}}</h2>
            
            <div class="prev_review_instance hidden" id="replying_to_review_div">
            </div>

            <form class="review_form" id="review_form" data-user-type="{{currentUser.userType}}">
                <div class="level_input_section {{#if (isCharter currentUser.userType)}}hidden{{/if}}">
                    <div class="reco_actions">
                        <input type="radio" id="acc" name="accuracy" value="accurate"
                            {{#if userReview.ratedAccurately}}checked{{/if}}>
                        <label class ="accurate" for="acc"> Rated Accurately </label>

                        <input type ="radio" id="notacc" name="accuracy" value="not_accurate"
                            {{#if (isFalse userReview.ratedAccurately)}}checked{{/if}}>
                        <label for="notacc" class ="not_accurate"> Not Rated Accurately </label>
                    </div>
                    
                    <label for="level_rating" id="slider_label">Level should be <span id="slider_value_label"></span></label>
                    <div class="slider_container" id="slider_div">
                        <span class="range_label"> 11.5 </span>
                        <input name="rating" type="range" min="11.5" max="15.0"
                            value="{{#if userReview.rating}}{{userReview.rating}}{{else}}{{chart.numericRating}}{{/if}}"
                            class="level_range" id="level_rating" step="0.1">
                        <span class="range_label">15.0</span>
                    </div>
                </div>
                <div class="review_body">
                    <textarea name="body" class="review_text" id="review_text" placeholder="Write your review here..." rows="6">
                        {{~#if userReview.body}}{{userReview.body}}{{/if~}}
                    </textarea>
                    <input name="file" type="file" id="review_file" accept="video/*, image/jpeg, image/png, image/webp"
                    {{#if (isCharter currentUser.userType)}}class="hidden"{{/if}}>
                </div>
                <div class="my_review_actions">
                    <button type="submit" class="delete_btn">Delete</button>
                    <button type="submit" class="submit_btn">Submit / Edit</button>
                </div>
            </form>
            </div>
        </div>

    <script>
        const reviewForm = document.getElementById("review_form");
        const reviewFormDiv = document.getElementById("review_form_div");
        const accButton = document.getElementById("acc");
        const notAccButton = document.getElementById("notacc");
        const sliderLabel = document.getElementById("slider_label");
        const sliderDiv = document.getElementById("slider_div");
        const slider = document.getElementById("level_rating");
        const sliderValueLabel = document.getElementById("slider_value_label");
        const reviewsDiv = document.getElementById("reviews_div");
        const reviewText = document.getElementById("review_text");
        const reviewFile = document.getElementById("review_file");
        const searchText = document.getElementById("search_text");
        const accSelDropdown = document.getElementById("acc_sel");
        const sortByDropdown = document.getElementById("sort_by");
        const searchButton = document.getElementById("search_button");
        const dialogLikeButton = document.getElementById("dialog_like_button");
        const replyingToReviewDiv = document.getElementById("replying_to_review_div");

        const EMPTY_HEART = "/assets/icons/heart.png";
        const FILLED_HEART = "/assets/icons/filled_heart.png"

        /* when you press "See full review", the like button of the corresponding review is saved here
           so that it can be updated once the user closes the full review */
        let currentReviewLikeButton;
        let currentReviewId;

        const currRoute = window.location.pathname;
        const chartId = currRoute.split("/")[2];
        let chartRating = slider.value; // placeholder for until async function executes

        async function renderReviews() {
            const query = {
                search: searchText.value,
                accuracy: accSelDropdown.value,
                sort: sortByDropdown.value
            };

            const params = new URLSearchParams(query);

            const response = await fetch(`/search_reviews/${chartId}?${params}`);

            const reviewsHtml = await response.text();

            reviewsDiv.innerHTML = reviewsHtml;
        }

        function round(number, numDecimalPlaces) {
            return parseFloat(number).toFixed(numDecimalPlaces);
        }

        function updateSliderValueLabel() {
            sliderValueLabel.innerHTML = round(slider.value, 1);
        }

        function updateAccuracySliderDisplay() {
            if (notAccButton.checked) {
                updateSliderValueLabel();
                sliderLabel.style.display = "block";
                sliderDiv.style.display = "flex";
            } else {
                slider.value = chartRating;
                sliderLabel.style.display = "none";
                sliderDiv.style.display = "none";
            }
        }

        async function getChartRating() {
            const response = await fetch("/get_chart_info/" + chartId);
            const chartInfo = await response.json();

            chartRating = chartInfo.numericRating;
        }

        function emptyReviewForm() {
            accButton.checked = false;
            notAccButton.checked = false;
            updateAccuracySliderDisplay();

            reviewText.value = "";
            reviewFile.value = null;
        }

        function formatDate(date) {
            return `${date.slice(5, 7)}/${date.slice(8, 10)}/${date.slice(0, 4)}`;
        }

        async function likeReview(button) {
            // button is the like button that was pressed

            const reviewId = button.dataset.reviewId; // data-review-id property
            const heartIcon = button.querySelector(".icon");
            const likeCount = button.querySelector(".like_count");

            const response = await fetch(`/like_review/${reviewId}`, { method: "POST" });

            if (!response.ok) {
                const message = await response.text();
                if (message) {
                    alert(message);
                }
                return;
            }

            const { action, success } = await response.json();

            if (!success) { // currently does not do anything because success is always true
                return;
            }

            const oldLikeCount = Number(likeCount.textContent);
            if (action === "liked") {
                if (heartIcon.src.includes(EMPTY_HEART)) { // includes() because "localhost:___" is included in src
                    heartIcon.src = FILLED_HEART;
                    if (oldLikeCount !== NaN) { // doesn't update if it's like "1.1k" anymore
                        likeCount.textContent = oldLikeCount + 1;
                    }
                }
            } else if (action === "unliked") {
                if (heartIcon.src.includes(FILLED_HEART)) {
                    heartIcon.src = EMPTY_HEART;
                    if (oldLikeCount !== NaN) {
                        likeCount.textContent = oldLikeCount - 1;
                    }
                }
            }

            // syncing up all the buttons
            document.querySelectorAll(`.like_button[data-review-id="${reviewId}"]`).forEach((elem) => {
                elem.querySelector(".icon").src = heartIcon.src;
                elem.querySelector(".like_count").textContent = likeCount.textContent;
            });
        }

        async function openReview(reviewId, button) {
            // button is the button that was pressed to call this function
            currentReviewLikeButton = button.parentElement.querySelector(".like_button");
            currentReviewId = reviewId;

            // carrying over if the review was liked or not, along with the like count
            const heartIconSrc = currentReviewLikeButton.querySelector(".icon").src;
            const likeCount = currentReviewLikeButton.querySelector(".like_count").textContent;

            document.getElementById("dialog_like_icon").src = heartIconSrc;
            document.getElementById("dialog_likes").textContent = likeCount;
            dialogLikeButton.dataset.reviewId = reviewId;

            const response = await fetch("/get_review_info/" + reviewId);
            const reviewInfo = await response.json();

            document.getElementById("dialog_username").textContent = reviewInfo.userId.username; 
            document.getElementById("dialog_avatar").src = reviewInfo.userId.imagePath; 
            document.getElementById("dialog_skill").textContent = reviewInfo.userId.rating; 
            document.getElementById("dialog_cc").textContent = reviewInfo.formattedRating; 
            document.getElementById("dialog_comment").textContent = reviewInfo.body;
            document.getElementById("dialog_created_at").textContent = `Created at: ${formatDate(reviewInfo.createdAt)}`;
            if (reviewInfo.isEdited) {
                document.getElementById("dialog_edited_at").textContent = `Edited at: ${formatDate(reviewInfo.editedAt)}`;
                document.getElementById("dialog_edited_at").classList.remove("hidden_elem");
            } else {
                document.getElementById("dialog_edited_at").textContent = "";
                document.getElementById("dialog_edited_at").classList.add("hidden_elem");
            }

            let recoIcon;
            if (reviewInfo.ratedAccurately) {
                recoIcon = "/assets/icons/reco.png";
            } else {
                recoIcon = "/assets/icons/not_reco.png";
            }
            document.getElementById("dialog_reco_icon").src = recoIcon;

            const attachmentContainer = document.querySelector('.review_attachment');

            if (reviewInfo.filePath) {
                if (reviewInfo.fileType === "video") {
                    attachmentContainer.innerHTML = `<video src="${reviewInfo.filePath}" controls> </video>`;
                } else {
                    attachmentContainer.innerHTML = `<img src="${reviewInfo.filePath}" alt="Review attachment">`;
                }
                attachmentContainer.style.display = 'block';
            } else {
                attachmentContainer.style.display = 'none';
            }
            
            document.getElementById("full_review").showModal();
        }

        function closeReview() {
            document.getElementById("full_review").close();
        }

        function openReplyForm(reviewId, button) {
            const correspondingReview = button.parentElement.parentElement.parentElement;
            const reviewCopy = correspondingReview.cloneNode(true); // deep copy

            replyingToReviewDiv.innerHTML = reviewCopy.innerHTML;
            replyingToReviewDiv.querySelector(".reply").remove();
            replyingToReviewDiv.dataset.reviewId = reviewId;
            replyingToReviewDiv.classList.remove("hidden");
            reviewFormDiv.classList.remove("hidden");
        }

        async function submitReviewForm(event) {
            const clickedButton = event.submitter;
            const buttonClasses = clickedButton.classList;
            const reviewInfo = new FormData(reviewForm);

            let response;
            if (buttonClasses.contains("delete_btn")) {
                response = await fetch(currRoute + "/delete_review", {
                    method: "DELETE"
                });
            } else {
                if (!reviewInfo.has("accuracy")) {
                    alert("Please select 'Rated Accurately' or 'Not Rated Accurately'.");
                    return;
                }

                if (reviewInfo.get("body") === "") {
                    alert("Please enter a review body.");
                    return;
                }

                response = await fetch(currRoute + "/submit_review", {
                    method: "POST",
                    body: reviewInfo
                });
            }

            if (!response.ok) {
                const message = await response.text();
                if (message) {
                    alert(message);
                }
                return;
            }

            const responseObj = await response.json();
            const { action, success } = responseObj;

            if (success) {
                await renderReviews(); // re-render the reviews to display the change

                switch (action) {
                    case "delete":
                        alert("Review successfully deleted.");
                        emptyReviewForm();
                        break;
                    case "edit":
                        alert("Review successfully edited.");
                        break;
                    case "submit":
                        alert("Review successfully submitted.");
                        break;
                }
            }
        }

        async function submitReplyForm(event) {
            const clickedButton = event.submitter;
            const buttonClasses = clickedButton.classList;
            const reviewId = replyingToReviewDiv.dataset.reviewId;

            let response;
            if (buttonClasses.contains("delete_btn")) {
                response = await fetch(`/delete_reply/${reviewId}`, {
                    method: "DELETE"
                });
            } else {
                const body = reviewText.value;

                if (body === "") {
                    alert("Please enter a reply body.");
                    return;
                }

                response = await fetch(`/submit_reply/${reviewId}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ body })
                });
            }

            if (!response.ok) {
                const message = await response.text();
                if (message) {
                    alert(message);
                }
                return;
            }

            const responseObj = await response.json();
            const { action, success } = responseObj;

            if (success) {
                await renderReviews(); // re-render the reviews to display the change

                switch (action) {
                    case "delete":
                        alert("Reply successfully deleted.");
                        emptyReviewForm();
                        break;
                    case "edit":
                        alert("Reply successfully edited.");
                        break;
                    case "submit":
                        alert("Reply successfully submitted.");
                        break;
                }
            }
        }

        getChartRating();
        updateAccuracySliderDisplay();
        updateSliderValueLabel();

        accButton.addEventListener("change", updateAccuracySliderDisplay);
        notAccButton.addEventListener("change", updateAccuracySliderDisplay);
        slider.addEventListener("input", updateSliderValueLabel);

        searchText.addEventListener("keydown", (event) => {
            if (event.key === "Enter" && !event.repeat) {
                renderReviews();
            }
        });

        searchButton.addEventListener("click", renderReviews);
        accSelDropdown.addEventListener("change", renderReviews);
        sortByDropdown.addEventListener("change", renderReviews);

		reviewForm.addEventListener("submit", async (event) => {
			event.preventDefault();

            const userType = reviewForm.dataset.userType;

            if (userType === "regular") {
                await submitReviewForm(event);
            } else if (userType === "charter") {
                await submitReplyForm(event);
            }
		});

        // handles liking reviews when a like button is pressed
        document.addEventListener("click", async (event) => {
            // the button that the user clicked on (if the user clicked a button)
            const button = event.target.closest("button");
            
            if (!button) {
                return;
            }

            if (button.classList.contains("like_button")) {
                await likeReview(button);
            }
        });
	</script>
</body>

</html>